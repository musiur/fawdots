[global]
    # Default (close_current on left-click) makes it impossible to confirm
    # actionable notifications like blueman's bluetooth pairing passkey
    # prompt — clicking just dismisses it instead of confirming, which
    # causes pairing to time out (br-connection-key-missing). Left-click
    # now triggers the notification's action (e.g. "Confirm") first.
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current
