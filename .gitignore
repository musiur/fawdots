# Generated by matugen from the current wallpaper — see matugen/ package.
# ~/.config/waybar is a whole-directory stow symlink, so this file physically
# lands inside the repo even though it's a build artifact, not source.
waybar/.config/waybar/colors.css

# Generated by scripts/.local/bin/neofetch-sticker (matugen post_hook for the
# `sticker` template) — picks the closest-matching file from
# ~/Pictures/Stickers/ and overwrites this one. ~/.config/neofetch pre-existed
# as a real dir before this repo touched it, so stow symlinks files
# individually here rather than the whole dir, and this build artifact
# physically lands inside the repo like colors.css above.
neofetch/.config/neofetch/stickers.png
